                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "video/mp4": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              },
              "audio/mpeg": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "video/mp4": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              },
              "audio/mpeg": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "direct-key": []
          }
        ],
        "summary": "Download a completed file",
        "tags": [
          "Downloads"
        ]
      }
    },
    "/v1/extract": {
      "post": {
        "description": "Extracts direct CDN streaming URLs and available qualities without saving files to the server. Fast response (1–2s). Ideal for client-side direct downloads.",
        "operationId": "ExtractController_extract",
        "parameters": [
