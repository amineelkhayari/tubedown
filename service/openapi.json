                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "direct-key": []
          }
        ],
        "summary": "Read download status",
        "tags": [
          "Downloads"
        ]
      },
      "delete": {
        "description": "Cancelled job records remain until expiry. Repeated cancellation is idempotent.",
        "operationId": "DownloadsController_cancel",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "Job is already completed or failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "direct-key": []
          }
        ],
        "summary": "Cancel a queued or processing download",
        "tags": [
          "Downloads"
        ]
      }
    },
    "/v1/jobs/{id}/file": {
      "get": {
        "description": "Requires the same consumer identity as job creation. Files expire after one hour by default.",
        "operationId": "DownloadsController_file",
        "parameters": [
          {
            "name": "id",
            "required": true,
