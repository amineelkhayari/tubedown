        ]
      }
    },
    "/v1/stream": {
      "get": {
        "description": "Proxies video/audio streaming directly from provider CDNs with provider-specific Referer and User-Agent headers, supporting HTTP 206 Range requests for seamless HTML5 video playback.",
        "operationId": "FallbackController_streamMedia",
        "parameters": [
          {
            "name": "url",
            "required": true,
            "in": "query",
            "description": "Direct CDN media stream URL to proxy",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platform",
            "required": false,
            "in": "query",
            "description": "Origin platform ID (e.g. instagram, tiktok, youtube)",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "Full media binary stream"
          },
          "206": {
            "description": "Partial media chunk stream with Content-Range"
          }
        },
        "summary": "Streaming proxy to bypass CDN hotlink protections and CORS blocks",
        "tags": [
          "Fallback & Streaming"
        ]
      }
    }
  },
  "info": {
    "title": "YTDownloader Media API",
    "description": "Direct media link extraction and asynchronous transcode downloads with NestJS. Supports instant direct CDN link extraction (/v1/extract) and server-side transcode jobs (/v1/jobs) with quality options from 144p to 4K and MP3 audio up to 320 kbps. Use Authorize with your direct API key for local testing. RapidAPI customers use their gateway key and host; the proxy secret is server-only.",
    "version": "1.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "direct-key": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Direct service key (API_KEY). Never share the operator key with RapidAPI consumers."
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "error"
        ]
      },
      "CreateDownloadDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://www.youtube.com/watch?v=BaW_jenozKc",
            "maxLength": 2048,
            "description": "Public single-media HTTPS URL from GET /v1/platforms."
          },
          "format": {
            "type": "string",
            "enum": [
              "mp4",
              "mp3"
            ],
            "default": "mp4"
          },
          "quality": {
            "type": "number",
            "enum": [
              144,
              240,
              360,
              480,
              720,
              1080,
              1440,
              2160
            ],
            "default": 720,
            "description": "Maximum video height (144p to 4K). Ignored for MP3."
          },
          "audioQuality": {
            "type": "string",
            "enum": [
              "128k",
              "192k",
              "256k",
              "320k"
            ],
            "default": "128k",
            "description": "Audio bitrate for MP3."
          }
        },
        "required": [
          "url"
        ]
      },
      "DownloadDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "mp4",
              "mp3"
            ]
          },
          "platform": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "error": {
            "type": "string"
          },
          "size": {
            "type": "number",
            "description": "Output size in bytes."
          },
          "downloadPath": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "format",
          "platform",
          "createdAt",
          "expiresAt"
        ]
      },
      "ExtractMediaDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://www.youtube.com/watch?v=BaW_jenozKc",
            "maxLength": 2048,
            "description": "Public media HTTPS URL."
          }
        },
        "required": [
          "url"
        ]
      },
      "MediaAuthorDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Creator Name"
          },
          "username": {
            "type": "object",
            "example": "@creator",
            "nullable": true
          },
          "url": {
            "type": "object",
            "example": "https://...",
            "nullable": true
          }
        },
        "required": [
          "name"
        ]
      },
      "DownloadShortcutsDto": {
        "type": "object",
        "properties": {
          "video": {
            "type": "object",
            "example": "https://...",
            "nullable": true
          },
          "audio": {
            "type": "object",
            "example": "https://...",
            "nullable": true
          }
        }
      },
      "MediaFormatDto": {
        "type": "object",
        "properties": {
          "formatId": {
            "type": "string",
            "example": "137"
          },
          "type": {
            "type": "string",
            "enum": [
              "video",
              "audio"
            ],
            "example": "video"
          },
          "quality": {
            "type": "string",
            "example": "1080p"
          },
          "resolution": {
            "type": "object",
            "example": "1920x1080",
            "nullable": true
          },
          "ext": {
            "type": "string",
            "example": "mp4"
          },
          "height": {
            "type": "object",
            "example": 1080,
            "nullable": true
          },
          "width": {
            "type": "object",
            "example": 1920,
            "nullable": true
          },
          "fps": {
            "type": "object",
            "example": 30,
            "nullable": true
          },
          "filesize": {
            "type": "object",
            "example": 15482900,
            "nullable": true
          },
          "filesizeFormatted": {
            "type": "object",
            "example": "14.8 MB",
            "nullable": true
          },
          "hasVideo": {
            "type": "boolean",
            "example": true
          },
          "hasAudio": {
            "type": "boolean",
            "example": true
          },
          "protocol": {
            "type": "string",
            "example": "https"
          },
          "url": {
            "type": "string",
            "example": "https://..."
          },
          "httpHeaders": {
            "type": "object",
            "description": "Required HTTP headers (User-Agent, Referer) for accessing protected CDN streams"
          },
          "cookies": {
            "type": "string",
            "description": "Required session cookies for accessing protected CDN streams"
          }
        },
        "required": [
          "formatId",
          "type",
          "quality",
          "ext",
          "hasVideo",
          "hasAudio",
          "url"
        ]
      },
      "ExtractedMediaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "jNQXAC9IVRw"
          },
          "platform": {
            "type": "string",
            "example": "youtube"
          },
          "title": {
            "type": "string",
            "example": "Sample Video Title"
          },
          "description": {
            "type": "object",
            "example": "Sample description",
            "nullable": true
          },
          "thumbnail": {
            "type": "object",
            "example": "https://i.ytimg.com/vi/...",
            "nullable": true
          },
          "duration": {
            "type": "number",
            "example": 19
          },
          "durationFormatted": {
            "type": "string",
            "example": "00:19"
          },
          "author": {
            "$ref": "#/components/schemas/MediaAuthorDto"
          },
          "uploader": {
            "type": "string",
            "example": "Creator Name"
          },
          "download": {
            "$ref": "#/components/schemas/DownloadShortcutsDto"
          },
          "medias": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaFormatDto"
            }
          },
          "formats": {
            "description": "Alias for medias array",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaFormatDto"
