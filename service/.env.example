API_KEY=replace-with-a-random-secret-at-least-32-characters
RAPIDAPI_PROXY_SECRET=
HOST=127.0.0.1
PORT=3000
WORKER_CONCURRENCY=2
FILE_TTL_MS=3600000
JOB_TIMEOUT_MS=900000
