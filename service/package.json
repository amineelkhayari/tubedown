{
  "name": "ytdownloader-service",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tools:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-media-tools.ps1",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "openapi:export": "npm run build && node dist/export-openapi.js"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "typescript": "^5.9.3"
  }
}
